# ── GitHub Secret "ENV_FILE" 에 이 내용을 채워서 저장하세요 ──
# EC2에 /opt/fitmap/.env 로 배포됩니다.

DB_HOST=db
DB_PORT=5432
DB_NAME=fitmap
DB_USER=<DB_USER>
DB_PASS=<DB_PASS>

REDIS_HOST=redis
REDIS_PORT=6379

KAKAO_CLIENT_ID=<KAKAO_CLIENT_ID>
KAKAO_CLIENT_SECRET=<KAKAO_CLIENT_SECRET>
KAKAO_REDIRECT_URI=https://api.fitmap.kr/api/v1/auth/oauth2/kakao/callback
KAKAO_REST_API_KEY=<KAKAO_REST_API_KEY>

GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://api.fitmap.kr/api/v1/auth/oauth2/google/callback

JWT_SECRET=<JWT_SECRET>
SIGNUP_TOKEN_SECRET=<SIGNUP_TOKEN_SECRET>

OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=gpt-4o

CORS_ALLOWED_ORIGINS=https://fitmap.kr,https://www.fitmap.kr
FRONTEND_URL=https://fitmap.kr
COOKIE_SECURE=true

SLACK_WEBHOOK_URL=<SLACK_WEBHOOK_URL>
